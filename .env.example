# Copy this file to ".env" and edit. Never commit .env. Restart the server after changing it.
# Every source marked "free" in the app works with NO keys. Keys below only ADD more sources.

DATABASE_URL=sqlite:///./osint_platform.db

# Optional: protects every /api route. Leave empty for a local demo. Use a long random value if others can reach the app.
APP_API_KEY=

# How often monitored cases are re-checked (minutes)
MONITOR_INTERVAL_MINUTES=15

# ---- Optional provider keys (leave blank to skip that provider) ----
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
OTX_API_KEY=
URLSCAN_API_KEY=

# ---- Optional AI summary (sends the collected findings to OpenAI) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
